# ---------- Telegram ----------
BOT_TOKEN=123456789:AAAA-your-bot-token-from-botfather
# Comma-separated Telegram user IDs jo admin honge (product add kar sakein)
ADMIN_IDS=123456789

# ---------- Database ----------
DB_PATH=shop.db

# ---------- Razorpay (UPI) ----------
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Webhook settings -> secret jo aap khud set karte ho Razorpay dashboard mein
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---------- Binance Pay ----------
# https://merchant.binance.com  -> API Management
BINANCE_PAY_API_KEY=your_binance_pay_api_key
BINANCE_PAY_API_SECRET=your_binance_pay_api_secret

# ---------- Public URL (webhook receive karne ke liye) ----------
# Local testing ke liye ngrok use karo: ngrok http 8000
PUBLIC_BASE_URL=https://yourdomain.com
WEBHOOK_SERVER_PORT=8000
